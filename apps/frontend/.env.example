# Documentacao das variaveis de ambiente do frontend
# O frontend usa NEXT_PUBLIC_API_BASE_URL para se comunicar com o backend.
# A url deve apontar para a origin (sem barra final, queries, fragments).

# Backend de desenvolvimento local (padrao):
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Backend de homologacao/producao:
# NEXT_PUBLIC_API_BASE_URL="https://api.instituicao.gov.br"
