{
  "name": "@sadep/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "npm run copy-check --workspace @sadep/frontend && npm run build --workspace @sadep/contracts && tsc --noEmit -p tsconfig.json && next build",
    "clean": "node ../../scripts/clean-frontend-cache.mjs",
    "copy-check": "node ../../scripts/check-frontend-copy.mjs",
    "dev": "npm run build --workspace @sadep/contracts && next dev --port 3001",
    "build": "npm run build --workspace @sadep/contracts && next build",
    "start": "next start --port 3001",
    "typecheck": "npm run build --workspace @sadep/contracts && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sadep/contracts": "0.1.0",
    "next": "15.5.15",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.5",
    "typescript": "^5.8.2"
  }
}
