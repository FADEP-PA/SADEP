NODE_ENV=development
PORT=3000

# PostgreSQL via docker-compose (docker-compose.yml na raiz do monorepo).
DATABASE_URL="postgresql://sadep:sadep_local_dev@localhost:5432/sadep"

# Producao: usar uma connection string com usuario/senha dedicados e SSL habilitado.
# Exemplo: DATABASE_URL="postgresql://sadep_prod:SENHA@host:5432/sadep?sslmode=require"

FRONTEND_ORIGIN="http://localhost:5000"

# Private document artifact storage. Do not expose this directory as static files.
ARTIFACT_STORAGE_DRIVER="filesystem"
ARTIFACT_STORAGE_ROOT=".data/private-artifacts"

# Required only when ARTIFACT_STORAGE_DRIVER=s3. Use private S3-compatible credentials.
ARTIFACT_STORAGE_S3_BUCKET=""
ARTIFACT_STORAGE_S3_REGION="us-east-1"
ARTIFACT_STORAGE_S3_ENDPOINT=""
ARTIFACT_STORAGE_S3_ACCESS_KEY_ID=""
ARTIFACT_STORAGE_S3_SECRET_ACCESS_KEY=""

# Required local values. Replace before running npm run backend:bootstrap.
JWT_SECRET="replace-with-a-local-secret-with-at-least-32-characters"
REFRESH_TOKEN_HMAC_SECRET="replace-with-a-local-refresh-secret-with-at-least-32-characters"
DEV_SEED_PASSWORD="replace-with-a-local-development-password"

# Session defaults for local development.
ACCESS_TOKEN_TTL="1h"
REFRESH_TOKEN_TTL="7d"
REFRESH_COOKIE_NAME="sadep_refresh"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""
COOKIE_PATH="/auth"
