NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
FRONTEND_ORIGIN="http://localhost:5000"

# Required local values. Replace before running npm run backend:bootstrap.
JWT_SECRET="replace-with-a-local-secret-with-at-least-32-characters"
REFRESH_TOKEN_HMAC_SECRET="replace-with-a-local-refresh-secret-with-at-least-32-characters"
DEV_SEED_PASSWORD="replace-with-a-local-development-password"

# Session defaults for local development.
ACCESS_TOKEN_TTL="1h"
REFRESH_TOKEN_TTL="7d"
REFRESH_COOKIE_NAME="aep_pa_refresh"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""
COOKIE_PATH="/auth"
