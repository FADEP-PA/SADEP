{
  "name": "@aep-pa/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "test": "npm run test:integration && npm run test:unit",
    "test:integration": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/processes/tests/run.ts",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:runner": "npm run test:integration",
    "test:jest": "npm run test:unit",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "ts-node --transpile-only -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aep-pa/contracts": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "jest": "^30.3.0",
    "prisma": "^6.8.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only -r tsconfig-paths/register prisma/seed.ts"
  }
}
